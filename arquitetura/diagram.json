  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],

    [ "lcd:GND", "esp:GND.2", "black", [] ],
    [ "lcd:VCC", "esp:5V", "red", [] ],
    [ "lcd:SDA", "esp:21", "green", [] ],
    [ "lcd:SCL", "esp:22", "orange", [] ],

    [ "btnEntrada:1.r", "esp:18", "green", [] ],
    [ "btnEntrada:2.r", "esp:GND.1", "black", [] ],
    [ "btnAtender:1.r", "esp:19", "blue", [] ],
    [ "btnAtender:2.r", "esp:GND.1", "black", [] ],

    [ "esp:25", "rVerde:1", "green", [] ],
    [ "rVerde:2", "ledVerde:A", "green", [] ],
    [ "ledVerde:C", "esp:GND.3", "black", [] ],
    [ "esp:26", "rVermelho:1", "red", [] ],
    [ "rVermelho:2", "ledVermelho:A", "red", [] ],
    [ "ledVermelho:C", "esp:GND.3", "black", [] ]
  ],
  "dependencies": {}
